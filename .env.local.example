# Supabase project connection.
# Copy this file to .env.local and fill in real values (never commit .env.local).

# Public — safe to expose to the browser. Used by lib/supabase/client.ts and lib/supabase/server.ts.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never import into client-rendered code.
# Per ARCHITECTURE.md section3, this key is deliberately not used by application request-handling
# code at all: money/loyalty mutations go through narrowly-scoped SECURITY DEFINER database
# functions (see DATABASE.md section7) instead of a service-role client. Reserved for genuine
# one-off infrastructure/migration scripts only.
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key
